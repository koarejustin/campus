# ═══════════════════════════════════════════════════════════════════════════════
#  CONFIGURATION - Système de Moyennes Burkina Faso
#  
#  Copier ce fichier en .env et adapter les valeurs
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 1. BACKEND NODE.JS / EXPRESS
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
HOST=localhost

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=votreMotDePasse123
DB_NAME=campus_numerique_db
DB_SSL=false

# JWT Secret (CHANGER EN PRODUCTION)
JWT_SECRET=votre_clé_secrète_très_très_longue_min_32_chars
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════════
# 2. API PYTHON FASTAPI
# ═══════════════════════════════════════════════════════════════════════════════

PYTHON_API_URL=http://localhost:8001
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_DEBUG=true

# ═══════════════════════════════════════════════════════════════════════════════
# 3. FRONTEND VUE.JS / REACT
# ═══════════════════════════════════════════════════════════════════════════════

VUE_APP_API_URL=http://localhost:3000
VUE_APP_WS_URL=ws://localhost:3000

# Ou pour React :
# REACT_APP_API_URL=http://localhost:3000
# REACT_APP_WS_URL=ws://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# 4. EMAIL (Optionnel - pour notifications)
# ═══════════════════════════════════════════════════════════════════════════════

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app
MAIL_FROM=noreply@campusnumerique.bf

# ═══════════════════════════════════════════════════════════════════════════════
# 5. LOGS ET DEBUG
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info
LOG_FILE=logs/app.log

# ═══════════════════════════════════════════════════════════════════════════════
# 6. CONFIGURATIONS MÉTIER
# ═══════════════════════════════════════════════════════════════════════════════

# Année scolaire actuelle
ANNEE_SCOLAIRE=2025-2026

# Pays/Région (pour système éducatif spécifique)
PAYS=BF
SYSTEME_EDUCATION=Burkina_Faso

# Nombre de trimestres
TRIMESTRES_PAR_AN=3

# Cache (en minutes)
CACHE_MOYENNES=60
CACHE_COEFFICIENTS=1440

# ═══════════════════════════════════════════════════════════════════════════════
# 7. WEBSOCKET (Temps réel)
# ═══════════════════════════════════════════════════════════════════════════════

SOCKET_ENABLED=true
SOCKET_RECONNECT_DELAY=5000

# ═══════════════════════════════════════════════════════════════════════════════
# 8. FEATURES FLAGS
# ═══════════════════════════════════════════════════════════════════════════════

FEATURE_PREDICTIONS=true
FEATURE_ALERTES=true
FEATURE_HISTORIQUE=true
FEATURE_EXPORT_PDF=false
FEATURE_MOBILE_APP=false
